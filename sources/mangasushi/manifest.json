{
  "manifest_version": 1,
  "id": "mangasushi",
  "name": "Mangasushi",
  "version": "1.1.0",
  "description": "Mangasushi (mangasushi.org): manga straight from the Mangasushi scanlation group's own site.",
  "author": {
    "name": "Tsubaki Team",
    "url": "https://github.com/tsubaki"
  },
  "license": "MIT",
  "repository": "https://github.com/ghero101/tsubaki-scraper-extensions",
  "addon_type": "scraper",
  "icon_path": "icon.png",
  "nsfw": false,
  "technology": "rhai",
  "entry_point": {
    "file": "plugin.rhai"
  },
  "capabilities": {
    "level": "http_only",
    "allowed_domains": [
      "mangasushi.org",
      "www.mangasushi.org"
    ],
    "requires_cookies": false,
    "requires_javascript": false,
    "cloudflare_protected": true
  },
  "features": {
    "search": true,
    "browse": true,
    "get_series": true,
    "get_chapters": true,
    "get_pages": true,
    "download": true,
    "get_covers": true
  },
  "authentication": {
    "type": "none"
  },
  "source_info": {
    "base_url": "https://mangasushi.org",
    "language": "en",
    "supported_languages": [
      "en"
    ],
    "content_rating": "suggestive",
    "tags": [
      "manga",
      "scanlator"
    ]
  },
  "rate_limiting": {
    "requests_per_minute": 30,
    "burst_limit": 3
  },
  "update": {
    "url": "https://raw.githubusercontent.com/ghero101/tsubaki-scraper-extensions/master/sources/mangasushi/manifest.json",
    "auto_update": true,
    "download_url": "https://raw.githubusercontent.com/ghero101/tsubaki-scraper-extensions/master/dist/mangasushi/mangasushi_latest.zip"
  }
}
