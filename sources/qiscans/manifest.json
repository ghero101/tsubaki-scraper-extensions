{
  "manifest_version": 1,
  "id": "qiscans",
  "name": "Quantum Scans",
  "version": "1.0.0",
  "description": "Quantum Scans (qimanga.com): manhwa and manhua straight from the scanlation group, via the site's public API. Paid early-access chapters show up once they become free.",
  "author": {
    "name": "Tsubaki Community",
    "url": "https://github.com/ghero101"
  },
  "license": "MIT",
  "repository": "https://github.com/ghero101/tsubaki-scraper-extensions",
  "addon_type": "scraper",
  "icon_path": "icon.png",
  "nsfw": false,
  "technology": "rhai",
  "entry_point": {
    "file": "plugin.rhai"
  },
  "capabilities": {
    "level": "http_only",
    "allowed_domains": [
      "qimanga.com",
      "www.qimanga.com",
      "api.qimanga.com",
      "storage.qimanga.com",
      "media.qimanga.com"
    ],
    "requires_cookies": false,
    "requires_javascript": false,
    "cloudflare_protected": false
  },
  "features": {
    "search": true,
    "browse": true,
    "get_series": true,
    "get_chapters": true,
    "get_pages": true,
    "download": true,
    "get_covers": true
  },
  "authentication": {
    "type": "none"
  },
  "source_info": {
    "base_url": "https://qimanga.com",
    "language": "en",
    "content_rating": "suggestive",
    "tags": [
      "scanlation",
      "scanlator",
      "manhwa",
      "iken"
    ]
  },
  "rate_limiting": {
    "requests_per_minute": 30,
    "burst_limit": 5
  },
  "allowed_domains": [
    "api.qimanga.com",
    "media.qimanga.com",
    "media.qiscans.org",
    "qimanga.com",
    "qiscans.org"
  ]
}
