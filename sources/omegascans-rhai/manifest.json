{
  "manifest_version": 1,
  "id": "omegascans",
  "name": "Omega Scans",
  "version": "1.0.1",
  "description": "Omega Scans - Adult manhwa and webtoon scanlation group",
  "author": {
    "name": "Tsubaki Team",
    "url": "https://github.com/tsubaki"
  },
  "license": "MIT",
  "repository": "https://github.com/ghero101/tsubaki-extensions",
  "addon_type": "scraper",
  "icon_path": "icon.png",
  "nsfw": true,
  "technology": "rhai",
  "entry_point": {
    "file": "plugin.rhai"
  },
  "capabilities": {
    "level": "http_only",
    "allowed_domains": [
      "omegascans.org",
      "api.omegascans.org",
      "media.omegascans.org"
    ],
    "requires_cookies": false,
    "requires_javascript": false,
    "cloudflare_protected": false
  },
  "features": {
    "search": true,
    "browse": true,
    "get_series": true,
    "get_chapters": true,
    "get_pages": true,
    "download": true,
    "get_covers": true
  },
  "authentication": {
    "type": "none"
  },
  "source_info": {
    "base_url": "https://omegascans.org",
    "language": "en",
    "supported_languages": [
      "en"
    ],
    "content_rating": "nsfw",
    "tags": [
      "scanlation",
      "manhwa",
      "webtoon",
      "adult"
    ]
  },
  "rate_limiting": {
    "requests_per_minute": 60,
    "burst_limit": 5
  },
  "update": {
    "url": "https://raw.githubusercontent.com/ghero101/tsubaki-extensions/master/sources/omegascans-rhai/manifest.json",
    "auto_update": true,
    "download_url": "https://raw.githubusercontent.com/ghero101/tsubaki-extensions/master/dist/omegascans-rhai/omegascans-rhai_latest.zip"
  }
}
